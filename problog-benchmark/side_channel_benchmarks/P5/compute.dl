.type s <: number
.type BitSet <: number
.type ind <: number

.decl assign(v0: s, v1: s)
.decl xor_assign_left(v0: s, v1: s)
.decl xor_assign_right(v0: s, v1: s)
.decl andor_assign_left(v0: s, v1: s)
.decl andor_assign_right(v0: s, v1: s)
.decl not_assign(v0: s, v1: s)
.decl load_assign(v0: s, v1: s)
.decl store_assign(v0: s, v1: s)
.decl zext_assign(v0: s, v1: s)
.decl sext_assign(v0: s, v1: s)
.decl icmp_assign(v0: s, v1: s)
.decl trunc_assign(v0: s, v1: s)
.decl share(v0: s, v1: s)
.decl binary_constant(v0: s, v1: s)
.decl equal_assign(v0: s, v1: s)
.decl BV_DIFF_REC(v0: s, v1: s, v2: BitSet)
.decl BV_SAME_REC(v0: s, v1: s, v2: BitSet)
.decl BV_ALL_INTERSECT(v0: s, v1: s, v2: BitSet)
.decl KEY_SENSITIVE(v0: s)
.decl KEY_IND(v0: s)
.decl CONSTANT(v0: s)
.decl RAND(v0: s)
.decl HD_SENSITIVE(v0: s, v1: s)
.decl HD_SENSITIVE_2(v0: s, v1: s)

RAND(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), ((RAND(from1), BV_DIFF_REC(from1, from2, int_res0), !((int_res0 = 0))); (RAND(from2), BV_DIFF_REC(from2, from1, int_res1), !((int_res1 = 0))))).
KEY_IND(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), ((RAND(from1), BV_DIFF_REC(from1, from2, int_res0), (int_res0 = 0)), (RAND(from2), BV_DIFF_REC(from2, from1, int_res1), (int_res1 = 0))), BV_SAME_REC(from1, from2, int_res0), (int_res0 = 0)).
KEY_SENSITIVE(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), ((RAND(from1), BV_DIFF_REC(from1, from2, int_res0), (int_res0 = 0)), (RAND(from2), BV_DIFF_REC(from2, from1, int_res1), (int_res1 = 0))), BV_SAME_REC(from1, from2, int_res0), !((int_res0 = 0))).
KEY_SENSITIVE(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), KEY_SENSITIVE(from1), KEY_SENSITIVE(from2)).
KEY_IND(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), KEY_IND(from1), KEY_IND(from2), BV_ALL_INTERSECT(from1, from2, int_res0), (int_res0 = 0)).
KEY_SENSITIVE(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), KEY_IND(from1), KEY_IND(from2), BV_ALL_INTERSECT(from1, from2, int_res0), !((int_res0 = 0))).
KEY_SENSITIVE(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), ((KEY_IND(from1), KEY_SENSITIVE(from2)); (KEY_IND(from2), KEY_SENSITIVE(from1)))).
KEY_IND(to) :- (andor_assign_left(to, from1), andor_assign_right(to, from2), ((RAND(from1), KEY_IND(from2)); (RAND(from2), KEY_IND(from1))), BV_ALL_INTERSECT(from1, from2, int_res0), (int_res0 = 0)).
KEY_SENSITIVE(to) :- (andor_assign_left(to, from1), andor_assign_right(to, from2), RAND(from1), KEY_IND(from2), BV_ALL_INTERSECT(from1, from2, int_res0), !((int_res0 = 0))).
KEY_IND(to) :- (andor_assign_left(to, from1), andor_assign_right(to, from2), RAND(from1), RAND(from2), ((BV_DIFF_REC(from1, from2, int_res0), !((int_res0 = 0))); (BV_DIFF_REC(from2, from1, int_res1), !((int_res1 = 0))))).
KEY_IND(to) :- (andor_assign_left(to, from1), andor_assign_right(to, from2), RAND(from1), RAND(from2), ((BV_DIFF_REC(from1, from2, int_res0), (int_res0 = 0)), (BV_DIFF_REC(from2, from1, int_res1), (int_res1 = 0))), BV_SAME_REC(from1, from2, int_res0), (int_res0 = 0)).
KEY_SENSITIVE(to) :- (andor_assign_left(to, from1), andor_assign_right(to, from2), RAND(from1), RAND(from2), ((BV_DIFF_REC(from1, from2, int_res0), (int_res0 = 0)), (BV_DIFF_REC(from2, from1, int_res1), (int_res1 = 0))), BV_SAME_REC(from1, from2, int_res0), !((int_res0 = 0))).
KEY_SENSITIVE(to) :- (andor_assign_left(to, from1), andor_assign_right(to, from2), (KEY_SENSITIVE(from1); KEY_SENSITIVE(from2))).
KEY_IND(to) :- (andor_assign_left(to, from1), andor_assign_right(to, from2), KEY_IND(from1), KEY_IND(from2), BV_ALL_INTERSECT(from1, from2, int_res0), (int_res0 = 0)).
KEY_SENSITIVE(to) :- (andor_assign_left(to, from1), andor_assign_right(to, from2), KEY_IND(from1), KEY_IND(from2), BV_ALL_INTERSECT(from1, from2, int_res0), !((int_res0 = 0))).
assign(from1, from2) :- load_assign(from1, from2).
assign(from1, from2) :- store_assign(from1, from2).
assign(from1, from2) :- binary_constant(from1, from2).
assign(from1, from2) :- sext_assign(from1, from2).
assign(from1, from2) :- zext_assign(from1, from2).
assign(from1, from2) :- trunc_assign(from1, from2).
KEY_SENSITIVE(from2) :- (KEY_SENSITIVE(from1), assign(from2, from1)).
KEY_IND(from2) :- (KEY_IND(from1), assign(from2, from1)).
RAND(from2) :- (RAND(from1), assign(from2, from1)).
equal_assign(from1, from2) :- load_assign(from1, from2).
equal_assign(from1, from2) :- store_assign(from1, from2).
equal_assign(from1, from2) :- sext_assign(from1, from2).
equal_assign(from1, from2) :- zext_assign(from1, from2).
equal_assign(from1, from2) :- trunc_assign(from1, from2).
equal_assign(from1, from3) :- (equal_assign(from1, from2), equal_assign(from2, from3)).
equal_assign(from2, from1) :- equal_assign(from1, from2).
HD_SENSITIVE(to_e, from2_e) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), share(to_e, from2_e), equal_assign(from2, from2_e), equal_assign(to, to_e), KEY_SENSITIVE(from1)).
HD_SENSITIVE(to_e, from2_e) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), share(from2_e, to_e), equal_assign(from2, from2_e), equal_assign(to, to_e), KEY_SENSITIVE(from1)).
HD_SENSITIVE(to_e, from1_e) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), share(to_e, from1_e), equal_assign(from1, from1_e), equal_assign(to, to_e), KEY_SENSITIVE(from2)).
HD_SENSITIVE(to_e, from1_e) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), share(from1_e, to_e), equal_assign(from1, from1_e), equal_assign(to, to_e), KEY_SENSITIVE(from2)).
KEY_IND(from1) :- CONSTANT(from1).
HD_SENSITIVE_2(to, from2) :- (load_assign(from1, from), store_assign(to, from1), HD_SENSITIVE(to, from2)).
HD_SENSITIVE_2(from2, to) :- (load_assign(from1, from), store_assign(to, from1), HD_SENSITIVE(from2, to)).

RAND(1).
KEY_SENSITIVE(2).
RAND(3).
load_assign(54, 2).
load_assign(16, 3).
xor_assign_left(17, 54).
xor_assign_right(17, 16).
BV_DIFF_REC(16, 54, 1).
store_assign(50, 17).
load_assign(19, 50).
load_assign(20, 1).
xor_assign_left(21, 19).
xor_assign_right(21, 20).
BV_DIFF_REC(19, 20, 1).
store_assign(4, 21).
load_assign(23, 4).
load_assign(24, 1).
xor_assign_left(25, 23).
xor_assign_right(25, 24).
BV_DIFF_REC(23, 24, 1).
store_assign(5, 25).
load_assign(66, 5).
load_assign(67, 50).
xor_assign_left(68, 66).
xor_assign_right(68, 67).
BV_DIFF_REC(67, 66, 0).
BV_DIFF_REC(66, 67, 0).
BV_SAME_REC(66, 67, 0).
store_assign(6, 68).
load_assign(70, 1).
load_assign(32, 3).
xor_assign_left(33, 70).
xor_assign_right(33, 32).
BV_DIFF_REC(70, 32, 1).
store_assign(7, 33).
load_assign(35, 50).
load_assign(36, 7).
xor_assign_left(37, 35).
xor_assign_right(37, 36).
BV_DIFF_REC(36, 35, 1).
store_assign(8, 37).
load_assign(39, 8).
load_assign(40, 7).
xor_assign_left(41, 39).
xor_assign_right(41, 40).
BV_DIFF_REC(40, 39, 1).
store_assign(9, 41).
load_assign(82, 9).
load_assign(83, 6).
xor_assign_left(84, 82).
xor_assign_right(84, 83).
BV_DIFF_REC(82, 83, 1).
store_assign(49, 84).
load_assign(86, 49).

.output KEY_IND
.output KEY_SENSITIVE
