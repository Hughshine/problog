// REC_RAND_VAR(var_y, Times, XY) :- (REC_RAND_VAR(var_x, Times, _), BV_ZERO_REC(var_x, var_y, Times), (XY = 0)).
// REC_RAND_VAR(var_z, Times, XY) :- (REC_RAND_VAR(var_x, Times, X), REC_RAND_VAR(var_y, Times, Y), BVOR_RAND_REC(var_x, var_y, var_z, Times), (XY = (X bor Y))).
// REC_RAND_VAR(var_z, Times, XY) :- (REC_RAND_VAR(var_x, Times, X), REC_RAND_VAR(var_y, Times, Y), SET_SUM_REC(var_x, var_y, var_z, Times), (XY = ((X band (bnot (Y))) bor ((bnot (X)) band Y)))).
// REC_RAND_VAR(var_z, Times, tmp) :- (REC_RAND_VAR(var_x, Times, X), REC_RAND_VAR(var_y, Times, Y), BVAND_REC(var_x, var_y, var_z, Times), (tmp = (X band Y))).
// SET_SUM_REC(from1, from2, to, Times) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), Time(Times), ((RAND(from1), BV_DIFF_REC(from1, from2, Times, int_res0), !((int_res0 = 0))); (RAND(from2), BV_DIFF_REC(from2, from1, Times, int_res1), !((int_res1 = 0))))).
// SET_SUM_REC(var_x, var_y, var_z, Times_New) :- (SET_SUM_REC(var_x, var_y, var_z, Times), !((Times_New = 0)), (Times_New = (Times - 1))).
TDEP(to, from) :- assign(to, from).
TDEP(to, prev) :- (assign(to, from), TDEP(from, prev)).
// XOR_RUD1_ALL_INC_REC(from1, from2, to, Times) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), Time(Times), (RAND(from1); RAND(from2))).
// XOR_RUD1_ALL_INC_REC(var_x, var_y, var_z, Times_New) :- (XOR_RUD1_ALL_INC_REC(var_x, var_y, var_z, Times), (Times_New = (Times - 1)), !((Times_New = 0))).
assign(to, from) :- load_assign(to, from).
assign(to, from) :- store_assign(to, from).
assign(to, from2) :- (assign(to, from1), assign(from1, from2)).
equal_assign(from1, to) :- (equal_assign(from1, from2), equal_assign(from2, to)).
equal_assign(to, from1) :- assign(to, from1).
equal_assign(to, from1) :- binary_constant(to, from1).
load_assign(to, from1) :- icmp_assign(to, from1).
load_assign(to, from1) :- trunc_assign(to, from1).
load_assign(to, from1) :- zext_assign(to, from1).
share(from2, from1) :- share(from1, from2).


