.type s <: number
.type BitSet <: number
.type ind <: number

.decl assign(v0: s, v1: s)
.decl TDEP(v0: s, v1: s)
.decl xor_assign_left(v0: s, v1: s)
.decl xor_assign_right(v0: s, v1: s)
.decl load_assign(v0: s, v1: s)
.decl store_assign(v0: s, v1: s)
.decl zext_assign(v0: s, v1: s)
.decl icmp_assign(v0: s, v1: s)
.decl trunc_assign(v0: s, v1: s)
.decl share(v0: s, v1: s)
.decl binary_constant(v0: s, v1: s)
.decl equal_assign(v0: s, v1: s)
.decl KEY_SENSITIVE(v0: s)
.decl KEY_IND(v0: s)
.decl RAND(v0: s)
.decl HD_SENSITIVE(v0: s, v1: s)
.decl RAND_NUMBER(v0: ind, v1: BitSet)
.decl KEY_NUMBER(v0: ind, v1: BitSet)
.decl REC_RAND_VAR(v0: s, v1: ind, v2: BitSet)
.decl REC_ALL_INC(v0: s, v1: ind, v2: BitSet)
.decl Time(v0: ind)
.decl XOR_RUD1_ALL_INC(v0: BitSet, v1: BitSet, v2: BitSet, v3: BitSet, v4: BitSet, v5: BitSet)
.decl BVAND_REC(v0: s, v1: s, v2: s, v3: ind)
.decl BVOR_RAND_REC(v0: s, v1: s, v2: s, v3: ind)
.decl BVOR_ALL_REC(v0: s, v1: s, v2: s, v3: ind)
.decl BV_INTERSECT_REC(v0: s, v1: s, v2: ind, v3: BitSet)
.decl INTERSECT_LABEL(v0: s, v1: s)
.decl BV_DIFF_REC(v0: s, v1: s, v2: ind, v3: BitSet)
.decl DIFF_LABEL(v0: s, v1: s)
.decl BV_SAME_REC(v0: s, v1: s, v2: ind, v3: BitSet)
.decl CHECK_SAME(v0: s, v1: s)
.decl SET_SUM_REC(v0: s, v1: s, v2: s, v3: ind)
.decl XOR_RUD1_ALL_INC_REC(v0: s, v1: s, v2: s, v3: ind)
.decl BV_EQUAL_RAND_REC(v0: s, v1: s, v2: ind)
.decl BV_EQUAL_ALL_REC(v0: s, v1: s, v2: ind)
.decl BV_ZERO_REC(v0: s, v1: s, v2: ind)

BVAND_REC(var_x, var_y, var_z, Times_New) :- (BVAND_REC(var_x, var_y, var_z, Times), !((Times = 0)), (Times_New = (Times - 1))).
BVOR_ALL_REC(from1, from2, to, Times) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), KEY_IND(from1), KEY_IND(from2), Time(Times)).
BVOR_ALL_REC(from1, from2, to, Times) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), Time(Times), KEY_SENSITIVE(from1), KEY_SENSITIVE(from2)).
BVOR_ALL_REC(var_x, var_y, var_z, Times_New) :- (BVOR_ALL_REC(var_x, var_y, var_z, Times), !((Times = 0)), (Times_New = (Times - 1))).
BVOR_RAND_REC(var_x, var_y, var_z, Times_New) :- (BVOR_RAND_REC(var_x, var_y, var_z, Times), !((Times = 0)), (Times_New = (Times - 1))).
BV_DIFF_REC(var_x, var_y, Times, XY) :- (REC_RAND_VAR(var_x, Times, X), REC_ALL_INC(var_y, Times, Y), (Times = 1), (XY = (X band ((X band (bnot (Y))) bor ((bnot (X)) band Y)))), DIFF_LABEL(var_x, var_y)).
BV_DIFF_REC(var_x, var_y, Times, int_res0) :- (REC_RAND_VAR(var_x, Times, X), REC_ALL_INC(var_y, Times, Y), !((Times = 1)), (XY = (X band ((X band (bnot (Y))) bor ((bnot (X)) band Y)))), DIFF_LABEL(var_x, var_y), (Times_New = (Times - 1)), BV_DIFF_REC(var_x, var_y, Times_New, XY_past), (int_res0 = (XY bor XY_past))).
BV_EQUAL_ALL_REC(from1, to, Times) :- (binary_constant(to, from1), Time(Times)).
BV_EQUAL_ALL_REC(from1, to, Times) :- (load_assign(to, from1), KEY_IND(from1), Time(Times)).
BV_EQUAL_ALL_REC(from1, to, Times) :- (load_assign(to, from1), KEY_SENSITIVE(from1), Time(Times)).
BV_EQUAL_ALL_REC(from1, to, Times) :- (load_assign(to, from1), RAND(from1), Time(Times)).
BV_EQUAL_ALL_REC(from1, to, Times) :- (store_assign(to, from1), KEY_IND(from1), Time(Times)).
BV_EQUAL_ALL_REC(from1, to, Times) :- (store_assign(to, from1), KEY_SENSITIVE(from1), Time(Times)).
BV_EQUAL_ALL_REC(from1, to, Times) :- (store_assign(to, from1), RAND(from1), Time(Times)).
BV_EQUAL_ALL_REC(var_x, var_y, Times_New) :- (BV_EQUAL_ALL_REC(var_x, var_y, Times), (Times_New = (Times - 1)), !((Times_New = 0))).
BV_EQUAL_RAND_REC(from1, to, Times) :- (binary_constant(to, from1), Time(Times)).
BV_EQUAL_RAND_REC(from1, to, Times) :- (load_assign(to, from1), KEY_IND(from1), Time(Times)).
BV_EQUAL_RAND_REC(from1, to, Times) :- (load_assign(to, from1), KEY_SENSITIVE(from1), Time(Times)).
BV_EQUAL_RAND_REC(from1, to, Times) :- (load_assign(to, from1), RAND(from1), Time(Times)).
BV_EQUAL_RAND_REC(from1, to, Times) :- (store_assign(to, from1), KEY_IND(from1), Time(Times)).
BV_EQUAL_RAND_REC(from1, to, Times) :- (store_assign(to, from1), KEY_SENSITIVE(from1), Time(Times)).
BV_EQUAL_RAND_REC(from1, to, Times) :- (store_assign(to, from1), RAND(from1), Time(Times)).
BV_EQUAL_RAND_REC(var_x, var_y, Times_New) :- (BV_EQUAL_RAND_REC(var_x, var_y, Times), (Times_New = (Times - 1)), !((Times_New = 0))).
BV_INTERSECT_REC(var_x, var_y, Times, XY) :- (REC_ALL_INC(var_x, Times, X), REC_ALL_INC(var_y, Times, Y), (Times = 1), (XY = (X band Y)), INTERSECT_LABEL(var_x, var_y)).
BV_INTERSECT_REC(var_x, var_y, Times, int_res0) :- (REC_RAND_VAR(var_x, Times, X), REC_ALL_INC(var_y, Times, Y), !((Times = 1)), (XY = (X band Y)), INTERSECT_LABEL(var_x, var_y), (Times_New = (Times - 1)), BV_INTERSECT_REC(var_x, var_y, Times_New, XY_past), (int_res0 = (XY bor XY_past))).
BV_SAME_REC(var_x, var_y, Times, XY) :- (REC_ALL_INC(var_x, Times, X), REC_ALL_INC(var_y, Times, Y), (Times = 1), (XY = ((X band (bnot (Y))) bor ((bnot (X)) band Y))), CHECK_SAME(var_x, var_y)).
BV_SAME_REC(var_x, var_y, Times, int_res0) :- (REC_ALL_INC(var_x, Times, X), REC_ALL_INC(var_y, Times, Y), !((Times = 1)), (XY = ((X band (bnot (Y))) bor ((bnot (X)) band Y))), CHECK_SAME(var_x, var_y), (Times_New = (Times - 1)), BV_SAME_REC(var_x, var_y, Times_New, XY_past), (int_res0 = (XY bor XY_past))).
BV_ZERO_REC(from1, to, Times) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), KEY_IND(from1), KEY_IND(from2), Time(Times)).
BV_ZERO_REC(from1, to, Times) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), Time(Times), ((RAND(from1), BV_DIFF_REC(from1, from2, Times, int_res0), (int_res0 = 0)), (RAND(from2), BV_DIFF_REC(from2, from1, Times, int_res1), (int_res1 = 0)))).
BV_ZERO_REC(from1, to, Times) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), Time(Times), KEY_SENSITIVE(from1), KEY_SENSITIVE(from2)).
BV_ZERO_REC(var_x, var_y, Times_New) :- (BV_ZERO_REC(var_x, var_y, Times), (Times_New = (Times - 1)), !((Times_New = 0))).
CHECK_SAME(from1, from2) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), Time(Times), ((RAND(from1), BV_DIFF_REC(from1, from2, Times, int_res0), (int_res0 = 0)), (RAND(from2), BV_DIFF_REC(from2, from1, Times, int_res1), (int_res1 = 0)))).
// DIFF_LABEL(from1, from2) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), Time(_), RAND(from1)).
// DIFF_LABEL(from2, from1) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), Time(_), RAND(from2)).
HD_SENSITIVE(to, from) :- (share(to, from), equal_assign(from_e, from), equal_assign(to_e, to), xor_assign_left(to_e, from1), xor_assign_right(to_e, from_e), KEY_SENSITIVE(from1)).
HD_SENSITIVE(to, from) :- (share(to, from), equal_assign(from_e, from), equal_assign(to_e, to), xor_assign_left(to_e, from_e), xor_assign_right(to_e, from1), KEY_SENSITIVE(from1)).
HD_SENSITIVE(to, from1) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), share(to, from1), KEY_SENSITIVE(from2)).
HD_SENSITIVE(to, from2) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), share(to, from2), KEY_SENSITIVE(from1)).
INTERSECT_LABEL(from1, from2) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), KEY_IND(from1), KEY_IND(from2)).
KEY_IND(to) :- ((equal_assign(from1, to); to = from1), KEY_IND(from1)).
KEY_IND(to) :- ((equal_assign(to, from1); to = from1), KEY_IND(from1)).
KEY_IND(to) :- (binary_constant(to, from1), KEY_IND(from1)).
KEY_IND(to) :- (load_assign(to, from1), KEY_IND(from1)).
KEY_IND(to) :- (store_assign(to, from1), KEY_IND(from1)).
KEY_IND(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), KEY_IND(from1), KEY_IND(from2), Time(Times), BV_INTERSECT_REC(from1, from2, Times, int_res0), (int_res0 = 0)).
KEY_IND(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), Time(Times), (RAND(from1); RAND(from2)), BV_SAME_REC(from1, from2, Times, int_res0), (int_res0 = 0)).
KEY_SENSITIVE(to) :- ((equal_assign(from1, to); to = from1), KEY_SENSITIVE(from1)).
KEY_SENSITIVE(to) :- ((equal_assign(to, from1); to = from1), KEY_SENSITIVE(from1)).
KEY_SENSITIVE(to) :- (binary_constant(to, from1), KEY_SENSITIVE(from1)).
KEY_SENSITIVE(to) :- (load_assign(to, from1), KEY_SENSITIVE(from1)).
KEY_SENSITIVE(to) :- (store_assign(to, from1), KEY_SENSITIVE(from1)).
KEY_SENSITIVE(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), KEY_IND(from1), KEY_IND(from2), Time(Times), BV_INTERSECT_REC(from1, from2, Times, int_res0), !((int_res0 = 0))).
KEY_SENSITIVE(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), KEY_SENSITIVE(from1), KEY_SENSITIVE(from2)).
KEY_SENSITIVE(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), Time(Times), (RAND(from1); RAND(from2)), BV_SAME_REC(from1, from2, Times, int_res0), !((int_res0 = 0))).
RAND(to) :- ((equal_assign(from1, to); to = from1), RAND(from1)).
RAND(to) :- ((equal_assign(to, from1); to = from1), RAND(from1)).
RAND(to) :- (binary_constant(to, from1), RAND(from1)).
RAND(to) :- (load_assign(to, from1), RAND(from1)).
RAND(to) :- (store_assign(to, from1), RAND(from1)).
RAND(to) :- (xor_assign_left(to, from1), xor_assign_right(to, from2), Time(Times), ((RAND(from1), BV_DIFF_REC(from1, from2, Times, int_res0), !((int_res0 = 0))); (RAND(from2), BV_DIFF_REC(from2, from1, Times, int_res1), !((int_res1 = 0))))).
// REC_ALL_INC(var_y, Times, X) :- (REC_ALL_INC(var_x, Times, X), BV_EQUAL_ALL_REC(var_x, var_y, Times)).
// REC_ALL_INC(var_z, Times, XY) :- (REC_ALL_INC(var_x, Times, X), REC_ALL_INC(var_y, Times, Y), BVOR_ALL_REC(var_x, var_y, var_z, Times), (XY = (X bor Y))).
// REC_ALL_INC(var_z, Times, XY) :- (REC_RAND_VAR(var_x, Times, X_R), REC_RAND_VAR(var_y, Times, Y_R), REC_ALL_INC(var_x, Times, X_A), REC_ALL_INC(var_y, Times, Y_A), RAND_NUMBER(Times, RAND_NUM), (XY = ((X_A bor Y_A) band ((bnot (RAND_NUM)) bor ((X_R band (bnot (Y_R))) bor ((bnot (X_R)) band Y_R))))), XOR_RUD1_ALL_INC_REC(var_x, var_y, var_z, Times)).
